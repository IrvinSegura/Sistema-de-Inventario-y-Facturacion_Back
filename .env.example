# Copy to .env (git-ignored) for local development.
# Base64 of at least 32 random bytes, e.g.: openssl rand -base64 32
JWT_SECRET=
# Initial admin, created on startup only if no admin exists.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=

# Password reset codes. Leave empty to only write codes to the log (local development).
# Email over SMTP (Gmail needs an app password; Brevo, Mailgun, etc. work too).
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
# Sender address, e.g. Inventory <no-reply@example.com>
MAIL_FROM=
# Web client the buttons in the emails open; empty sends emails with no button.
EMAIL_APP_URL=http://localhost:5173
# SMS with Twilio: account SID, auth token and a Twilio number in E.164 (+15005550006).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Product images on Cloudinary (Settings > API Keys). Leave empty to keep them in uploads/images locally.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
